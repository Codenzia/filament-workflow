{
    "name": "codenzia/filament-workflow",
    "description": "Visual workflow automation engine for Filament 4+ built on filament-diagrammer",
    "keywords": [
        "filament",
        "workflow",
        "automation",
        "laravel",
        "diagrammer"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Codenzia",
            "email": "dev@codenzia.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Codenzia/filament-diagrammer-dev.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0 || ^5.0",
        "codenzia/filament-diagrammer": "^0.2 || ^0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Codenzia\\FilamentWorkflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codenzia\\FilamentWorkflow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codenzia\\FilamentWorkflow\\FilamentWorkflowServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
